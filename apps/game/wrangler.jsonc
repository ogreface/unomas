{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flipside-game",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  // One Worker serves the SPA and the API. Static assets are served directly; only the two dynamic
  // route prefixes below wake the Worker. `single-page-application` returns index.html for any
  // client-side route so deep links like /r/ABCD work on a hard refresh.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // One Durable Object per room. SQLite-backed (new_sqlite_classes) so the game log and snapshot
  // persist, and the object hibernates between moves instead of billing for idle wall-clock.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
