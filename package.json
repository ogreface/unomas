{
  "name": "flipside",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @flipside/game test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev": "pnpm --filter @flipside/game dev",
    "deploy": "pnpm --filter @flipside/game deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
